diff --git a/src/libs/XYCSwapMath.sol b/src/libs/XYCSwapMath.sol
new file mode 100644
index 0000000..8201324
--- /dev/null
+++ b/src/libs/XYCSwapMath.sol
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: LicenseRef-Degensoft-SwapVM-1.1
+pragma solidity 0.8.30;
+
+/// @custom:license-url https://github.com/1inch/swap-vm/blob/main/LICENSES/SwapVM-1.1.txt
+/// @custom:copyright © 2025 Degensoft Ltd
+
+import { Math } from "@openzeppelin/contracts/utils/math/Math.sol";
+
+/// @dev Single source of truth for the XYC amount and rounding semantics.
+library XYCSwapMath {
+    function exactIn(uint256 balanceIn, uint256 balanceOut, uint256 amountIn)
+        internal
+        pure
+        returns (uint256 amountOut)
+    {
+        // Floor division for tokenOut is maker-favoring and matches XYCSwap.
+        return (amountIn * balanceOut) / (balanceIn + amountIn);
+    }
+
+    function exactOut(uint256 balanceIn, uint256 balanceOut, uint256 amountOut)
+        internal
+        pure
+        returns (uint256 amountIn)
+    {
+        // Ceiling division for tokenIn is maker-favoring and matches XYCSwap.
+        return Math.ceilDiv(amountOut * balanceIn, balanceOut - amountOut);
+    }
+}
diff --git a/src/instructions/XYCConcentrate.sol b/src/instructions/XYCConcentrate.sol
index 11db80d..5ad7540 100644
--- a/src/instructions/XYCConcentrate.sol
+++ b/src/instructions/XYCConcentrate.sol
@@ -51,6 +51,27 @@ library XYCConcentrateArgsBuilder {
         sqrtPriceSpot = Math.sqrt(Math.mulDiv(virtualGt, ONE*ONE, virtualLt));
     }
 
+    /// @notice Apply the exact virtual-reserve transformation used by XYCConcentrate.
+    function virtualBalances(
+        uint256 balanceIn,
+        uint256 balanceOut,
+        bool isTokenInLt,
+        uint256 sqrtPriceMin,
+        uint256 sqrtPriceMax
+    ) internal pure returns (uint256 virtualIn, uint256 virtualOut) {
+        uint256 bLt = isTokenInLt ? balanceIn : balanceOut;
+        uint256 bGt = isTokenInLt ? balanceOut : balanceIn;
+        uint256 liquidity = _computeL(bLt, bGt, sqrtPriceMin, sqrtPriceMax);
+
+        if (isTokenInLt) {
+            virtualIn = balanceIn + Math.ceilDiv(liquidity * ONE, sqrtPriceMax);
+            virtualOut = balanceOut + Math.mulDiv(liquidity, sqrtPriceMin, ONE);
+        } else {
+            virtualIn = balanceIn + Math.ceilDiv(liquidity * sqrtPriceMin, ONE);
+            virtualOut = balanceOut + Math.mulDiv(liquidity, ONE, sqrtPriceMax);
+        }
+    }
+
     /// @notice Compute the initial balances for given L, P_spot, P_min, P_max:
     ///   bLt = L * (sqrtPmax - sqrtPspot) / (sqrtPmax * sqrtPspot)
     ///   bGt = L * (sqrtPspot - sqrtPmin)
