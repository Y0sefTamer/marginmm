-            ctx.swap.balanceOut += Math.mulDiv(L, ONE, sqrtPriceMax);
-        }
+        (ctx.swap.balanceIn, ctx.swap.balanceOut) = XYCConcentrateArgsBuilder.virtualBalances(
+            ctx.swap.balanceIn,
