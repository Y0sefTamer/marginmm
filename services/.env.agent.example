# Copy to services/.env.agent.local. Never commit the local file.
GROQ_API_KEY=replace_with_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GRAPH_API_KEY=replace_with_the_graph_gateway_key
HEDERA_AGENT_ACCOUNT_ID=0.0.0000000
HEDERA_AGENT_PRIVATE_KEY=replace_with_a_dedicated_testnet_ecdsa_private_key
HEDERA_PAYTO_ACCOUNT_ID=0.0.0000000
X402_PRICE_TINYBAR=replace_with_the_exact_calibrator_price
POLICY_VALIDITY_SECONDS=21600
POLICY_REFRESH_LEAD_SECONDS=900

# Optional only when deliberately changing the pinned subgraph deployments.
# UNISWAP_SUBGRAPH_ID=
# AAVE_SUBGRAPH_ID=
