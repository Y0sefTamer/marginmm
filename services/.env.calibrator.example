# Copy to services/.env.calibrator.local. Never commit the local file.
MARGINMM_ETHEREUM_RPC_URL=http://127.0.0.1:8545
CALIBRATION_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
CALIBRATION_SIGNER_PRIVATE_KEY=replace_with_a_dedicated_local_dev_private_key
GRAPH_API_KEY=replace_with_the_graph_gateway_key
HEDERA_PAYTO_ACCOUNT_ID=0.0.0000000
X402_PRICE_TINYBAR=replace_with_positive_integer_tinybar_price
# Absolute local path for the durable x402 idempotency journal.
CALIBRATION_IDEMPOTENCY_PATH=replace_with_absolute_local_journal_path
CALIBRATION_PORT=4021

# Optional only when deliberately changing the pinned subgraph deployments.
# UNISWAP_SUBGRAPH_ID=
# AAVE_SUBGRAPH_ID=
