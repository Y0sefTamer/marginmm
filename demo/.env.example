# Copy to demo/.env.local. Never commit the local file.
# Generate a new 24-word phrase locally; never fund or reuse these accounts on a public network.
ANVIL_DEMO_MNEMONIC="replace with a local demo-only 24-word mnemonic"

# Public address derived from the dedicated key in services/.env.calibrator.local.
# This is an identity, not a private key.
CALIBRATION_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
